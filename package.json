{
    "name":  "miaodraw",
    "version":  "0.1.0",
    "description":  "濡欑粯宸ヤ綔鍙?- AI 鍥惧儚鍒涗綔瀹㈡埛绔紙闃块噷浜戠櫨鐐奸┍鍔級",
    "main":  "./out/main/index.js",
    "author":  "miaodraw",
    "license":  "MIT",
    "private":  true,
    "scripts":  {
                    "lint":  "oxlint src",
                    "typecheck:node":  "tsc --noEmit -p tsconfig.node.json --composite false",
                    "typecheck:web":  "tsc --noEmit -p tsconfig.web.json --composite false",
                    "typecheck":  "npm run typecheck:node \u0026\u0026 npm run typecheck:web",
                    "test:canvas":  "node --test src/renderer/src/canvas/connection-hit.test.mjs",
                    "test:orchestrator":  "node --test src/main/orchestrator/state.test.mjs src/main/orchestrator/registry.test.mjs",
                    "test:prompt":  "node --test src/main/prompt-guards.test.mjs",
                    "test":  "npm run test:canvas \u0026\u0026 npm run test:orchestrator \u0026\u0026 npm run test:prompt",
                    "start":  "electron-vite preview",
                    "dev":  "electron-vite dev",
                    "build":  "npm run typecheck \u0026\u0026 electron-vite build",
                    "app":  "npm run build \u0026\u0026 electron .",
                    "shot":  "npm run build \u0026\u0026 cross-env TEST_MODE=screenshot electron .",
                    "build:win":  "npm run build \u0026\u0026 electron-builder --win"
                },
    "dependencies":  {
                         "@huggingface/transformers":  "^4.3.0"
                     },
    "devDependencies":  {
                            "@ant-design/icons":  "^6.0.0",
                            "@ant-design/v5-patch-for-react-19":  "^1.0.3",
                            "@electron-toolkit/tsconfig":  "^2.0.0",
                            "@types/node":  "^22.19.1",
                            "@types/react":  "^19.2.7",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^5.1.1",
                            "antd":  "^5.29.0",
                            "cross-env":  "^10.1.0",
                            "dayjs":  "^1.11.23",
                            "electron":  "^39.2.6",
                            "electron-builder":  "^26.0.12",
                            "electron-vite":  "^5.0.0",
                            "konva":  "^10.7.0",
                            "oxlint":  "^1.86.0",
                            "react":  "^19.2.1",
                            "react-dom":  "^19.2.1",
                            "react-konva":  "^19.3.0",
                            "typescript":  "^5.9.3",
                            "vite":  "^7.2.6"
                        }
}
